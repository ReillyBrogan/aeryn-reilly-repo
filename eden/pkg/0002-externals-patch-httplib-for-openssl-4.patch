From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Reilly Brogan <reilly@reillybrogan.com>
Date: Sun, 15 Nov 2026 23:15:00 -0600
Subject: [PATCH] externals: patch httplib for OpenSSL 4

OpenSSL 4.0 removed X509_NAME_dup() and made X509_get_subject_name()
return a const pointer, so the bundled cpp-httplib no longer compiles.

Origin: vendor
Forwarded: not-needed
Last-Update: 2026-11-15
---
 .../0003-openssl-4.0-x509-name-dup.patch      | 47 +++++++++++++++++++
 externals/cpmfile.json                        |  3 +-
 2 files changed, 49 insertions(+), 1 deletion(-)
 create mode 100644 .patch/httplib/0003-openssl-4.0-x509-name-dup.patch

diff --git a/.patch/httplib/0003-openssl-4.0-x509-name-dup.patch b/.patch/httplib/0003-openssl-4.0-x509-name-dup.patch
new file mode 100644
index 0000000..06d428b
--- /dev/null
+++ b/.patch/httplib/0003-openssl-4.0-x509-name-dup.patch
@@ -0,0 +1,47 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Reilly Brogan <reilly@reillybrogan.com>
+Date: Sun, 15 Nov 2026 23:10:00 -0600
+Subject: [PATCH] Build against OpenSSL 4, which removed X509_NAME_dup()
+
+Replace it with ASN1_item_dup() and make the subject name const, as
+X509_get_subject_name() now returns a const pointer.
+---
+ httplib.h | 12 ++++++++---
+ 1 file changed, 9 insertions(+), 3 deletions(-)
+
+diff --git a/httplib.h b/httplib.h
+@@ -16151,6 +16151,14 @@
+   }
+ }
+ 
++// OpenSSL 4.0 removed X509_NAME_dup()
++inline X509_NAME *x509_name_dup(const X509_NAME *name) {
++  if (!name) { return nullptr; }
++  return static_cast<X509_NAME *>(
++      ASN1_item_dup(ASN1_ITEM_rptr(X509_NAME),
++                    const_cast<X509_NAME *>(name)));
++}
++
+ // Helper: Create client CA list from PEM string
+ // Returns a new STACK_OF(X509_NAME)* or nullptr on failure
+ // Caller takes ownership of returned list
+@@ -16170,8 +16178,8 @@
+   X509 *cert = nullptr;
+   while ((cert = PEM_read_bio_X509(bio, nullptr, nullptr, nullptr)) !=
+          nullptr) {
+-    X509_NAME *name = X509_get_subject_name(cert);
+-    if (name) { sk_X509_NAME_push(ca_list, X509_NAME_dup(name)); }
++    const X509_NAME *name = X509_get_subject_name(cert);
++    if (name) { sk_X509_NAME_push(ca_list, x509_name_dup(name)); }
+     X509_free(cert);
+   }
+   BIO_free(bio);
+@@ -16203,7 +16211,7 @@
+       if (cert) {
+         auto subject = X509_get_subject_name(cert);
+         if (subject) {
+-          auto name_dup = X509_NAME_dup(subject);
++          auto name_dup = x509_name_dup(subject);
+           if (name_dup) { sk_X509_NAME_push(ca_list, name_dup); }
+         }
+       }
diff --git a/externals/cpmfile.json b/externals/cpmfile.json
index 0302f11..606e66d 100644
--- a/externals/cpmfile.json
+++ b/externals/cpmfile.json
@@ -33,7 +33,8 @@
         "find_args": "MODULE GLOBAL",
         "patches": [
             "0001-mingw.patch",
-            "0002-fix-zstd.patch"
+            "0002-fix-zstd.patch",
+            "0003-openssl-4.0-x509-name-dup.patch"
         ],
         "options": [
             "HTTPLIB_REQUIRE_OPENSSL ON",
