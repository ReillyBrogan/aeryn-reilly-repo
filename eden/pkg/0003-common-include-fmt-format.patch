From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Reilly Brogan <reilly@reillybrogan.com>
Date: Sun, 15 Nov 2026 23:40:00 -0600
Subject: [PATCH] common: include <fmt/format.h> where fmt::format() is used

fmt::format() lives in format.h since fmt 10; core.h alone no longer
declares it.

Origin: vendor
Forwarded: not-needed
Last-Update: 2026-11-15
---
 src/common/settings.cpp                  | 2 +-
 src/common/settings_setting.h            | 2 +-
 src/yuzu/configuration/shared_widget.cpp | 2 +-
 src/yuzu/startup_checks.cpp              | 2 +-
 4 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/common/settings.cpp b/src/common/settings.cpp
index 54848c4..6010fde 100644
--- a/src/common/settings.cpp
+++ b/src/common/settings.cpp
@@ -17,7 +17,7 @@
 #include <string_view>
 #include <type_traits>
 #include <deque>
-#include <fmt/core.h>
+#include <fmt/format.h>
 
 #include "common/settings_enums.h"
 #include "common/assert.h"
diff --git a/src/common/settings_setting.h b/src/common/settings_setting.h
index 076acee..f01a66c 100644
--- a/src/common/settings_setting.h
+++ b/src/common/settings_setting.h
@@ -13,7 +13,7 @@
 #include <string>
 #include <typeindex>
 #include <typeinfo>
-#include <fmt/core.h>
+#include <fmt/format.h>
 #include "common/common_types.h"
 #include "common/settings_common.h"
 #include "common/settings_enums.h"
diff --git a/src/yuzu/configuration/shared_widget.cpp b/src/yuzu/configuration/shared_widget.cpp
index ce11763..9fc9c6d 100644
--- a/src/yuzu/configuration/shared_widget.cpp
+++ b/src/yuzu/configuration/shared_widget.cpp
@@ -36,7 +36,7 @@
 #include <QVariant>
 #include <QtCore/qglobal.h>
 #include <QtCore/qobjectdefs.h>
-#include <fmt/core.h>
+#include <fmt/format.h>
 #include <qglobal.h>
 #include <qnamespace.h>
 
diff --git a/src/yuzu/startup_checks.cpp b/src/yuzu/startup_checks.cpp
index f54992d..e49f755 100644
--- a/src/yuzu/startup_checks.cpp
+++ b/src/yuzu/startup_checks.cpp
@@ -20,7 +20,7 @@
 #include <unistd.h>
 #endif
 
-#include <fmt/core.h>
+#include <fmt/format.h>
 #include "video_core/vulkan_common/vulkan_instance.h"
 #include "video_core/vulkan_common/vulkan_library.h"
 #include "yuzu/startup_checks.h"
