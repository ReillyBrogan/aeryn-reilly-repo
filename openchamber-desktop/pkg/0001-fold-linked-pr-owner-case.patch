From 6182ca5270433801cf408a84cc1e8b7b0467b8e1 Mon Sep 17 00:00:00 2001
From: Reilly Brogan <reilly@reillybrogan.com>
Date: Sun, 11 Oct 2026 14:11:59 -0500
Subject: [PATCH] fix(ui): fold linked PR owner/repo case to stop the sidebar
 render loop

Two sessions that link the same pull request with different casing
(AerynOS/recipes#2833 and aerynOS/recipes#2833) crash the sidebar with
React #185. The tracked-item key already folds case, so both rows read one
shared PR-summary cache entry, but the signature did not fold and each row
rewrote it on every read, so useSyncExternalStore never settled.

Fold owner/repo the same way trackedItemKey does, for the canonical URL and
the summary's repo fields alike. #4541 fixed the fragment/query spelling of
this loop; this closes the casing one.

Fixes #4541

Origin: vendor
Forwarded: https://github.com/openchamber/openchamber/issues/4541
Last-Update: 2026-10-11
---
 .../src/stores/useGitHubPrStatusStore.test.ts | 19 ++++++++++
 .../ui/src/stores/useGitHubPrStatusStore.ts   | 36 +++++++++++--------
 2 files changed, 41 insertions(+), 14 deletions(-)

diff --git a/packages/ui/src/stores/useGitHubPrStatusStore.test.ts b/packages/ui/src/stores/useGitHubPrStatusStore.test.ts
index 7e2445e0d..2f177d2c9 100644
--- a/packages/ui/src/stores/useGitHubPrStatusStore.test.ts
+++ b/packages/ui/src/stores/useGitHubPrStatusStore.test.ts
@@ -1369,6 +1369,25 @@ describe("linked change request summary URL canonicalization (#4541)", () => {
     expect(anchored?.url).toBe(link.url)
   })
 
+  test("owner casing of one PR shares a stable summary reference", () => {
+    // A real profile links one PR from two sessions as `AerynOS/recipes` and
+    // `aerynOS/recipes`; GitHub resolves both to one thread and trackedItemKey
+    // already folds the case. The shared cache signature must fold too, or each
+    // read returns a fresh summary and useSyncExternalStore loops (#185).
+    const key = "runtime-a|github|pull|aerynos/recipes#2833"
+    const upper = { owner: "AerynOS", repo: "recipes", number: 2833, url: "https://github.com/AerynOS/recipes/pull/2833", title: "feature" }
+    const lower = { ...upper, owner: "aerynOS", url: "https://github.com/aerynOS/recipes/pull/2833" }
+    const casingState: GitHubPullRequestLiveSummary = { ...state, owner: "aerynOS", repo: "recipes", number: 2833 }
+    const first = getLinkedChangeRequestVisualSummary(key, upper, casingState, identity)
+    const folded = getLinkedChangeRequestVisualSummary(key, lower, casingState, identity)
+    const again = getLinkedChangeRequestVisualSummary(key, upper, casingState, identity)
+    expect(first).not.toBeNull()
+    expect(folded).toBe(first)
+    expect(again).toBe(first)
+    expect(first?.url).toBe("https://github.com/aerynos/recipes/pull/2833")
+    expect(first?.repo).toEqual({ owner: "aerynos", repo: "recipes" })
+  })
+
   test("canonical URLs keep a self-managed GitHub instance host", () => {
     const gheIdentity = { provider: "github" as const, instance: "https://ghe.acme.example" }
     const summary = getLinkedChangeRequestVisualSummary(
diff --git a/packages/ui/src/stores/useGitHubPrStatusStore.ts b/packages/ui/src/stores/useGitHubPrStatusStore.ts
index af0844bf2..803a1fa9a 100644
--- a/packages/ui/src/stores/useGitHubPrStatusStore.ts
+++ b/packages/ui/src/stores/useGitHubPrStatusStore.ts
@@ -1625,14 +1625,15 @@ const linkedPrStatus = (
 });
 
 /**
- * The canonical URL of a linked change request. Links shared with a fragment
- * or query (a review anchor like `#pullrequestreview-…`, a notification
- * query) name the same thread, and the summary cache below is shared per
- * tracked item: if two sessions link the same PR with different URL
- * spellings, a summary built from the raw link URL flips the cache signature
- * on every read, the selector result is never referentially stable, and
- * useSyncExternalStore loops until React throws "Maximum update depth
- * exceeded" (#185). Every summary therefore uses the canonical thread URL.
+ * The canonical URL of a linked change request. Hosts treat owner/repo case
+ * insensitively and links may be shared with a fragment or query (a review
+ * anchor like `#pullrequestreview-…`, a notification query); all such
+ * spellings name the same thread. The summary cache below is shared per
+ * tracked item (whose key is already lower-cased), so any spelling that flips
+ * the cache signature yields a fresh object on every read, the selector result
+ * is never referentially stable, and useSyncExternalStore loops until React
+ * throws "Maximum update depth exceeded" (#185). Every summary therefore uses
+ * the canonical, case-folded thread URL.
  */
 const canonicalChangeRequestUrl = (
   link: LinkedGitHubPullRequest,
@@ -1640,11 +1641,11 @@ const canonicalChangeRequestUrl = (
 ): string => {
   if (identity.provider === 'github') {
     const host = instanceHost(identity.instance) ?? 'github.com';
-    return `https://${host}/${link.owner}/${link.repo}/pull/${link.number}`;
+    return `https://${host}/${link.owner.toLowerCase()}/${link.repo.toLowerCase()}/pull/${link.number}`;
   }
   try {
     const parsed = new URL(link.url);
-    return `${parsed.origin}${parsed.pathname}`;
+    return `${parsed.origin}${parsed.pathname.toLowerCase()}`;
   } catch {
     return link.url;
   }
@@ -1660,10 +1661,17 @@ export const getLinkedChangeRequestVisualSummary = (
   link: LinkedGitHubPullRequest,
   summary: GitHubPullRequestLiveSummary,
   identity: SourceControlIdentity,
-): PrVisualSummary | null => getCachedPrSummary(
-  `linked:${cacheKey}`,
-  linkedPrStatus({ ...link, url: canonicalChangeRequestUrl(link, identity) }, summary, identity),
-);
+): PrVisualSummary | null => {
+  // Hosts resolve owner/repo case insensitively and the tracked item key
+  // already lower-cases them: fold the link the same way, or two sessions
+  // linking one PR with different casing would flip the shared cache entry's
+  // signature (via both the repo fields and the URL) on every read.
+  const folded = { ...link, owner: link.owner.toLowerCase(), repo: link.repo.toLowerCase() };
+  return getCachedPrSummary(
+    `linked:${cacheKey}`,
+    linkedPrStatus({ ...folded, url: canonicalChangeRequestUrl(folded, identity) }, summary, identity),
+  );
+};
 
 
